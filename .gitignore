# ============================================================
# AutoWorth AI — .gitignore
# ============================================================

# ──────────────────────────────────────────────
# Python / Backend
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
ENV/

# MyPy
.mypy_cache/
.dmypy.json
dmypy.json

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Alembic generated versions (keep only committed migrations)
# Uncomment the line below if you want to exclude ALL migration files
# backend/alembic/versions/*.py

# ML artifacts
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
backend/app/ml/weights/
backend/app/ml/artifacts/
backend/storage/

# ──────────────────────────────────────────────
# Node / Frontend
# ──────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
frontend/.next/
frontend/out/
frontend/node_modules/

# ──────────────────────────────────────────────
# Environment & Secrets
# ──────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production
backend/.env
frontend/.env.local

# ──────────────────────────────────────────────
# IDE / OS
# ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────
.cache/
tmp/
temp/


docs
